# DOMAIN=localhost  -> HTTPS lokal (sertifikat internal Caddy)
# DOMAIN=tugas.contoh.id -> sertifikat Let's Encrypt otomatis di VPS (DNS harus mengarah ke IP VPS)
{$DOMAIN:localhost} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:80
	}
}
